---
import { formatMoney, resultRows } from '../lib/results';
import InfoIcon from '../components/InfoIcon.astro';
import HistoryData from '../components/HistoryData.astro';
import {
  currencyPage as pageForCurrency,
  jcbSourceUrl,
} from '../lib/currency-page';
import '../styles/global.css';
import ratesData from '../data/rates.json';
import {
  currencies,
  availableDates,
  formatFetchedAt,
  rateEntries,
  historyDates,
  periodComparison,
} from '../lib/rates';

interface Props {
  defaultCurrency?: string;
  currencyPage?: boolean;
}
const { defaultCurrency = 'JPY', currencyPage = false } = Astro.props;
const currencyInfo = currencies[defaultCurrency];
const pageInfo = pageForCurrency(defaultCurrency);
const heading = currencyPage ? pageInfo.heading : '外幣刷卡匯率比較與試算';
const title = `${heading}｜VISA、Mastercard、JCB — FX Pulse`;
const description = currencyPage
  ? pageInfo.description
  : '比較 VISA、Mastercard 與 JCB 的外幣刷卡參考匯率，支援日圓、美元等 8 種幣別，查看歷史走勢並試算台幣金額。JCB 為交叉匯率估算，未計銀行手續費與回饋。';
const canonical = new URL(
  currencyPage ? `/${defaultCurrency.toLowerCase()}/` : '/',
  Astro.site,
).href;
const shareImage = new URL('/og/fx-pulse.png', Astro.site).href;
const dates = availableDates(ratesData.rates);
const earliestDate = dates.at(0) ?? '';
const latestDate = dates.at(-1) ?? '';
const initialComparison = periodComparison(
  ratesData.rates,
  historyDates(dates, latestDate, '7'),
  defaultCurrency,
);
const differenceText = (value: number | null) =>
  value === null ? '—' : `約 NT$ ${formatMoney(value, 'TWD')}`;
const fetchedAt = formatFetchedAt(ratesData.meta.last_updated);
const jcbSource = jcbSourceUrl(ratesData.rates, dates, defaultCurrency);
const copyrightYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111720" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="FX Pulse 匯率脈動" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="FX Pulse：貓掌在日圓、美元與台幣主題的卡片間挑選，旁邊有熟睡的三花貓。刷卡前，比一下。"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta
      name="twitter:image:alt"
      content="FX Pulse：貓掌選卡與熟睡的三花貓。刷卡前，比一下。"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="FX Pulse 首頁">
          <svg
            class="brand-mark"
            viewBox="0 0 40 40"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 21c6-13 11-13 17 0s11 13 17 0"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            />
            <path
              d="M3 25c6-13 11-13 17 0s11 13 17 0"
              stroke="currentColor"
              stroke-opacity=".25"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <span>FX Pulse</span>
        </a>
        <h1 id="page-heading">{heading}</h1>
        <span class="header-updated">
          最後更新{' '}
          <time datetime={ratesData.meta.last_updated}>{fetchedAt}</time>
        </span>
        <a
          class="github-link"
          href="https://github.com/HeiTang/FX-Pulse"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="在新分頁開啟 FX Pulse GitHub 專案"
          title="GitHub 專案"
        >
          <img
            src="/icons/github.svg"
            width="22"
            height="22"
            alt=""
            aria-hidden="true"
          />
        </a>
      </div>
    </header>

    <main class="shell">
      <div class="route-board">
        <div class="field currency-field">
          <span class="route-label" id="foreign-label">
            消費幣別
          </span>
          <strong id="route-code" class="route-code">
            {defaultCurrency}
          </strong>
          <span class="route-name">
            <span id="route-flag" class="route-flag" aria-hidden="true">
              {currencyInfo.flag}
            </span>
            <span id="route-name">{currencyInfo.name}</span>
          </span>
          <input
            id="currency"
            name="currency"
            type="hidden"
            value={defaultCurrency}
          />
        </div>
        <button
          type="button"
          id="swap-direction"
          class="route-arrow"
          aria-label="切換換算方向"
          aria-pressed="false"
          title="切換換算方向"
        >
          <span aria-hidden="true">↔</span>
        </button>
        <div class="route-destination">
          <span id="twd-label">換算幣別</span>
          <strong class="route-code">TWD</strong>
          <span class="route-name">
            <span class="route-flag" aria-hidden="true">
              🇹🇼
            </span>
            <span>新台幣</span>
          </span>
        </div>
      </div>
      <section class="workspace" aria-label="外幣消費試算">
        <nav class="currency-shortcuts" aria-label="快速選擇幣別">
          {ratesData.meta.currencies.map((code) => (
            <a
              href={pageForCurrency(code).path}
              data-quick-currency={code}
              aria-current={code === defaultCurrency ? 'page' : undefined}
              aria-label={`${currencies[code]?.name ?? code} ${code}`}
            >
              <span class="currency-flag" aria-hidden="true">
                {currencies[code]?.flag ?? '🌐'}
              </span>
              <span class="shortcut-heading">
                <strong>{code}</strong>
                <span class="shortcut-name">
                  {currencies[code]?.name ?? code}
                </span>
              </span>
              <span class="shortcut-rate" data-shortcut-rate>
                {(() => {
                  const best = rateEntries(
                    ratesData.rates,
                    code,
                    latestDate,
                  ).sort((a, b) => a.rate - b.rate)[0];
                  return best
                    ? `${best.src === 'JCB' ? '約 ' : ''}${new Intl.NumberFormat('zh-TW', { maximumSignificantDigits: 4 }).format(best.rate)}`
                    : '—';
                })()}
              </span>
            </a>
          ))}
        </nav>
        <p class="shortcut-hint" id="shortcut-hint">
          <InfoIcon />
          <span id="shortcut-hint-text">
            每 1 外幣 → TWD · 最低參考匯率 · 所選日期
          </span>
        </p>
        <div class="input-panel">
          <div class="field amount-field">
            <label id="amount-label" for="amount">
              消費金額
            </label>
            <div class="amount-wrap">
              <span id="amount-code">{defaultCurrency}</span>
              <input
                id="amount"
                name="amount"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                value="10,000"
                aria-describedby="amount-error"
              />
            </div>
            <small id="amount-error" class="field-error" role="alert"></small>
          </div>
          <div class="field date-field">
            <label id="rate-date-label" for="date-trigger">
              匯率日期
            </label>
            <div class="date-select">
              <input
                id="rate-date"
                name="rate-date"
                type="date"
                min={earliestDate}
                max={latestDate}
                value={latestDate}
                required
                hidden
              />
              <button
                id="date-trigger"
                type="button"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="date-picker"
                aria-labelledby="rate-date-label date-display"
              >
                <svg
                  class="date-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect x="4" y="5" width="16" height="16" rx="4" />
                  <path d="M8 3v4m8-4v4M4 11h16m-11 4h2m2 0h2" />
                </svg>
                <span id="date-display">{latestDate.replaceAll('-', '/')}</span>
                <span class="date-chevron" aria-hidden="true">
                  ⌄
                </span>
              </button>
              <div
                id="date-picker"
                class="date-picker"
                role="dialog"
                aria-label="選擇匯率日期"
                hidden
              >
                <div class="calendar-header">
                  <button
                    type="button"
                    data-month-step="-1"
                    aria-label="上個月"
                  >
                    ‹
                  </button>
                  <strong id="calendar-month" aria-live="polite"></strong>
                  <button type="button" data-month-step="1" aria-label="下個月">
                    ›
                  </button>
                </div>
                <div class="calendar-weekdays" aria-hidden="true">
                  {['日', '一', '二', '三', '四', '五', '六'].map((day) => (
                    <span>{day}</span>
                  ))}
                </div>
                <div
                  id="calendar-days"
                  class="calendar-days"
                  role="group"
                  aria-label="日期"
                ></div>
                <p class="calendar-range">
                  資料期間 {earliestDate.replaceAll('-', '/')}–
                  {latestDate.replaceAll('-', '/')}
                </p>
              </div>
            </div>
            <small
              id="date-error"
              class="field-error date-error"
              role="status"
            ></small>
          </div>
        </div>
        <p
          id="query-message"
          class="field-error query-message"
          role="status"
        ></p>
      </section>

      <section class="comparison" aria-labelledby="comparison-title">
        <div class="section-heading comparison-heading">
          <h2 id="comparison-title">換算結果</h2>
          <span class="comparison-context" id="comparison-context">
            {defaultCurrency} → TWD
          </span>
        </div>
        <div class="comparison-panel">
          <div class="table-head" aria-hidden="true">
            <span>卡組織</span>
            <span id="rate-heading">每 1 外幣匯率</span>
            <span id="total-heading">換算台幣</span>
            <span id="difference-heading">與最低值的差額</span>
          </div>
          <div id="results" class="results" aria-live="polite">
            {resultRows(
              ratesData.rates,
              defaultCurrency,
              latestDate,
              10000,
            ).map((row) => (
              <div class:list={['result-row', { 'is-best': row.best }]}>
                <div class="result-headline">
                  <div class="result-source">
                    <span class="source-icon" aria-hidden="true">
                      <img src={`/icons/${row.src.toLowerCase()}.svg`} alt="" />
                    </span>
                    <strong>{row.src}</strong>
                    {row.src === 'JCB' && (
                      <span class="source-estimate">交叉匯率估算</span>
                    )}
                  </div>
                  <div class="result-total">
                    <strong>{row.totalText}</strong>
                  </div>
                </div>
                <div class="result-details">
                  <div class="result-rate">
                    <span>{row.rateText}</span>
                  </div>
                  <div
                    class:list={[
                      'result-difference',
                      { 'best-badge': row.best },
                    ]}
                  >
                    {row.differenceText}
                  </div>
                </div>
              </div>
            ))}
          </div>
          <script is:inline>
            {
              const results = document.querySelector('#results');
              // Measure before first paint so delayed app loading cannot shift the rows.
              const syncLayout = () => {
                results.classList.remove('is-stacked');
                const headlines = [
                  ...results.querySelectorAll('.result-headline'),
                ];
                if (
                  !headlines.length ||
                  getComputedStyle(headlines[0]).display !== 'flex'
                )
                  return;
                const needsStacking = headlines.some((headline) => {
                  const source = headline.querySelector('.result-source');
                  const total = headline.querySelector('.result-total strong');
                  return (
                    source.getBoundingClientRect().width +
                      total.getBoundingClientRect().width +
                      parseFloat(getComputedStyle(headline).columnGap) >
                    headline.getBoundingClientRect().width
                  );
                });
                results.classList.toggle('is-stacked', needsStacking);
              };
              results.addEventListener('resultschange', syncLayout);
              let width = 0;
              new ResizeObserver(([entry]) => {
                if (entry.contentRect.width === width) return;
                width = entry.contentRect.width;
                requestAnimationFrame(syncLayout);
              }).observe(results);
              void document.fonts.ready.then(syncLayout);
              syncLayout();
            }
          </script>
          <div
            id="comparison-message"
            class="comparison-message"
            role="status"
          ></div>
        </div>
        <p class="fine-print" id="conversion-note">
          <InfoIcon />
          <span id="conversion-note-text">
            未計銀行手續費與回饋，非實際帳單。JCB 為交叉匯率估算。
          </span>
        </p>
      </section>

      <div class="rate-guide rate-views" id="rate-info">
        <nav class="view-tabs" aria-label="匯率資料檢視">
          <a
            href="#view-chart"
            id="tab-chart"
            aria-controls="view-chart"
            data-view="chart"
          >
            匯率走勢
          </a>
          <a
            href="#view-history"
            id="tab-history"
            aria-controls="view-history"
            data-view="history"
          >
            歷史匯率
          </a>
          <a
            href="#view-method"
            id="tab-method"
            aria-controls="view-method"
            data-view="method"
          >
            計算與資料說明
          </a>
        </nav>
        <section
          class="history"
          id="view-chart"
          data-view-panel
          aria-labelledby="history-title"
        >
          <div class="history-panel">
            <div class="history-toolbar">
              <h2 id="history-title">
                匯率走勢 <span id="chart-title">{defaultCurrency} / TWD</span>
              </h2>
              <div class="segmented" role="group" aria-label="走勢期間">
                <button type="button" data-range="7" aria-pressed="true">
                  7 天
                </button>
                <button type="button" data-range="30" aria-pressed="false">
                  30 天
                </button>
                <button type="button" data-range="all" aria-pressed="false">
                  全部
                </button>
              </div>
            </div>
            <div class="source-filters" role="group" aria-label="走勢資料來源">
              <button type="button" data-source="all" aria-pressed="true">
                全部來源
              </button>
              <button type="button" data-source="VISA" aria-pressed="false">
                <i class="legend-dot visa"></i> VISA
              </button>
              <button
                type="button"
                data-source="Mastercard"
                aria-pressed="false"
              >
                <i class="legend-dot mastercard"></i> Mastercard
              </button>
              <button type="button" data-source="JCB" aria-pressed="false">
                <i class="legend-dot jcb"></i> JCB
              </button>
            </div>
            <div id="chart" role="img" aria-label="歷史匯率走勢圖"></div>
            <div id="chart-placeholder" class="chart-placeholder" hidden>
              所選期間可用資料不足，無法繪製走勢。
            </div>
            <p class="chart-note" id="chart-note">
              1 外幣 = TWD · 截至所選日期 · 線段可能跨過缺資料日
            </p>
            <details class="period-comparison" id="period-comparison">
              <summary>
                <span class="period-summary-title">期間統計</span>
                <span id="period-sources-hint" class="period-summary-hint">
                  卡組織匯率比較
                </span>
                <svg
                  class="period-chevron"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="period-content">
                <div class="period-heading">
                  <p id="period-context" class="period-context">
                    近 7 天 · {defaultCurrency} · 三家比較
                  </p>
                  <p id="period-dates" class="period-muted">
                    截至 {latestDate}
                  </p>
                </div>
                <div class="period-grid">
                  <div class="period-days">
                    <dl class="period-stats">
                      <div class="period-count-row">
                        <dt>同日可比較</dt>
                        <dd id="period-count">{initialComparison.count} 天</dd>
                      </div>
                      <div>
                        <dt>
                          <i class="legend-dot visa" aria-hidden="true"></i>
                          <span id="period-visa-label">VISA 最低</span>
                        </dt>
                        <dd id="period-visa">
                          {initialComparison.bestDays.VISA} 天
                        </dd>
                      </div>
                      <div>
                        <dt>
                          <i
                            class="legend-dot mastercard"
                            aria-hidden="true"
                          ></i>
                          <span id="period-mastercard-label">
                            Mastercard 最低
                          </span>
                        </dt>
                        <dd id="period-mastercard">
                          {initialComparison.bestDays.Mastercard} 天
                        </dd>
                      </div>
                      <div>
                        <dt>
                          <i class="legend-dot jcb" aria-hidden="true"></i>
                          <span id="period-jcb-label">JCB 最低（估算）</span>
                        </dt>
                        <dd id="period-jcb">
                          {initialComparison.bestDays.JCB} 天
                        </dd>
                      </div>
                      <div class="period-muted">
                        <dt id="period-tied-label">最低並列</dt>
                        <dd id="period-tied">{initialComparison.tied} 天</dd>
                      </div>
                    </dl>
                  </div>
                  <div class="period-money">
                    <p id="period-amount" class="period-muted">
                      換算 {formatMoney(10_000, defaultCurrency)}{' '}
                      {defaultCurrency} → TWD
                    </p>
                    <dl class="period-stats">
                      <div class="period-median-row">
                        <dt>差額中位數</dt>
                        <dd id="period-median">
                          {differenceText(initialComparison.median)}
                        </dd>
                      </div>
                      <div class="period-maximum-row">
                        <dt>最大差額</dt>
                        <dd id="period-maximum">
                          {differenceText(initialComparison.maximum)}
                        </dd>
                      </div>
                    </dl>
                  </div>
                </div>
                <p id="period-message" class="period-message" role="status">
                  {initialComparison.count === 0
                    ? '所選期間沒有同日、同幣別且三家都有有效匯率的資料。'
                    : ''}
                </p>
                <div class="period-footnote">
                  <p>
                    <InfoIcon />
                    <span>
                      僅計同日、同幣別三家資料齊全日；最低並列另計，JCB 為估算。
                    </span>
                  </p>
                  <p>
                    <InfoIcon />
                    <span>
                      差額＝每日最高－最低，含並列日；未計銀行手續費與回饋。
                    </span>
                  </p>
                </div>
              </div>
            </details>
          </div>
        </section>
        <HistoryData code={defaultCurrency} />
        {ratesData.meta.currencies.map((code) => (
          <template data-history-currency={code}>
            <HistoryData code={code} />
          </template>
        ))}
        <section
          class="guide-details"
          id="view-method"
          data-view-panel
          aria-labelledby="method-title"
        >
          <h2 id="method-title">計算與資料說明</h2>
          <div class="guide-detail-content">
            <div class="guide-formulas">
              <h3>換算方式</h3>
              <div class="guide-formula">
                <span>外幣 → 台幣</span>
                <div>
                  <b>外幣金額</b>
                  <span>×</span>
                  <b>匯率</b>
                </div>
              </div>
              <div class="guide-formula">
                <span>台幣 → 外幣</span>
                <div>
                  <b>台幣金額</b>
                  <span>÷</span>
                  <b>匯率</b>
                </div>
              </div>
              <p class="guide-formula-note">
                參考換算額，未含銀行手續費與回饋。
              </p>
            </div>
            <div class="guide-sources">
              <h3>官方資料</h3>
              {[
                {
                  name: 'VISA',
                  icon: 'visa',
                  note: '匯率計算器',
                  url: 'https://www.visa.com.tw/support/consumer/travel-support/exchange-rate-calculator.html',
                },
                {
                  name: 'Mastercard',
                  icon: 'mastercard',
                  note: '匯率計算器',
                  url: 'https://www.mastercard.com/global/en/personal/get-support/currency-exchange-rate-converter.html',
                },
                {
                  name: 'JCB',
                  icon: 'jcb',
                  note: '美元基準 · 交叉匯率估算',
                  url: jcbSource,
                },
              ].map((source) => (
                <a
                  class="guide-source"
                  href={source.url}
                  data-jcb-source-link={source.name === 'JCB' ? '' : undefined}
                >
                  <img
                    src={`/icons/${source.icon}.svg`}
                    width="24"
                    height="24"
                    alt=""
                  />
                  <span>
                    <strong>{source.name}</strong>
                    <small>{source.note}</small>
                  </span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              ))}
            </div>
            <p class="guide-caveat">
              帳單依實際處理日與銀行規則計算；商店 DCC 換匯不適用。
            </p>
          </div>
        </section>
      </div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>
          © {copyrightYear} HeiTang<span class="footer-separator">・</span>
        </span>
        <span>資料來源：VISA / Mastercard / JCB</span>
      </div>
    </footer>

    <script>
      import '../lib/app';
    </script>
  </body>
</html>
